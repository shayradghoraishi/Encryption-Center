{
  "$schema": "node_modules/wrangler/config-schema.json",
  // نام پروژه روی Cloudflare — در صورت تمایل تغییرش بده
  "name": "encryption-center",
  "compatibility_date": "2026-09-23",

  // این اپ کاملاً client-side است (بدون منطق سمت سرور)،
  // پس فقط خروجی build (پوشه dist) را به عنوان Static Assets سرو می‌کنیم.
  "assets": {
    "directory": "./dist",
    // چون از react-router-dom با HashRouter استفاده شده،
    // هر مسیر ناشناخته باید به index.html برگردد (SPA fallback).
    "not_found_handling": "single-page-application"
  }
}
